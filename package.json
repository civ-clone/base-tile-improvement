{
  "name": "@civ-clone/base-tile-improvement",
  "version": "0.1.0",
  "description": "Building blocks for a rule set's tile improvements: where each can go (from Requirement entries, with rule-set Conditions), what building, pillaging and removing one does, and the yield modifiers they make. The rule set keeps its own rules and numbers.",
  "repository": "git@github.com:civ-clone/base-tile-improvement.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/core-terrain": "^0.1.4",
    "@civ-clone/core-world-generator": "^0.1.7",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/core-engine": "^0.1.0",
    "@civ-clone/core-government": "^0.1.0",
    "@civ-clone/core-player": "^0.1.0",
    "@civ-clone/core-requirement": "^0.1.2",
    "@civ-clone/core-rule": "^0.1.0",
    "@civ-clone/core-science": "^0.1.0",
    "@civ-clone/core-tile-improvement": "^0.1.6",
    "@civ-clone/core-world": "^0.1.24",
    "@civ-clone/core-yield": "^0.1.0"
  }
}
